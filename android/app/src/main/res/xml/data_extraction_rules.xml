<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude everything from both cloud backup and device-to-device transfer.
     App storage holds Keystore-wrapped credentials and files pulled from a
     private self-hosted server; neither should leave the device. Paired with
     android:allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
