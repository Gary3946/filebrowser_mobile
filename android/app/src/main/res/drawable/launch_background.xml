<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 splash (windowBackground of LaunchTheme): the brand mark
     centered on the indigo base. Android 12+ ignores this and uses the
     windowSplashScreen* attributes in values-v31/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/quantum_indigo" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_splash" />
    </item>
</layer-list>
