<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: native attributes, no library needed. The
     splash design is dark by design, so day and night are identical (see
     values-night-v31/). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/quantum_indigo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
