<?xml version="1.0" encoding="utf-8"?>
<!-- Same splash as values-v31/ (the design is dark already); only the base
     theme parent differs to match the night LaunchTheme. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/quantum_indigo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
